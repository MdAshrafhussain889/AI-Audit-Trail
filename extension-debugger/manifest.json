{
  "manifest_version": 3,
  "name": "AI Audit Trail - Shadow Detector (Debugger)",
  "version": "0.3.0",
  "description": "Logs shadow AI usage (ChatGPT, Copilot) via Chrome DevTools Protocol",
  "permissions": ["tabs", "storage", "debugger"],
  "host_permissions": [
    "http://localhost:*/*",
    "https://localhost:*/*",
    "http://*/*",
    "https://*/*",
    "*://copilot.microsoft.com/*",
    "*://github.com/*",
    "*://claude.ai/*",
    "*://chat.openai.com/*",
    "*://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Audit Trail",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}

# ============================================================================
# AI Audit Trail — Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control (it's in .gitignore)
#
# cp .env.example .env
# ============================================================================

# ─ Backend Server Configuration ───────────────────────────────────────────
# Backend runs on this URL (local development or deployed)
BACKEND_URL=http://localhost:8000

# Local SQLite DB used by default when DATABASE_URL is not set
DATABASE_URL=sqlite:///./audit.db

# OpenAI API Key (REQUIRED - get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-openai-api-key-here

# CORS allowed origins (comma-separated; "*" allows all)
# Leave empty to allow all origins, or specify:"http://localhost:5173,http://localhost:3000"
ALLOWED_ORIGINS=*

# ─ Frontend Configuration ─────────────────────────────────────────────────
# API base URL for frontend (used during build)
# When building frontend, set this to your deployed backend URL
VITE_API_BASE_URL=http://localhost:8000

# ─ Travel Planner Agent Configuration ─────────────────────────────────────
# Backend API URL for agent audit logging (same as BACKEND_URL + /api/...)
AGENT_AUDIT_API_URL=http://localhost:8000/api/agent-audit/events

# Optional: Bearer token for agent audit API authentication
AGENT_AUDIT_TOKEN=

# OpenWeather API Key (OPTIONAL - if not set, agent uses mock weather data)
# Get from https://openweathermap.org/api
OPENWEATHER_API_KEY=

# ─ Chrome Extension Configuration ─────────────────────────────────────────
# Backend URL for Chrome extension detector (same as BACKEND_URL)
# Note: Browser extensions cannot use environment variables at runtime
# You may need to manually update extension files if changing URLs
EXTENSION_BACKEND_URL=http://localhost:8000

# ============================================================================
# TROUBLESHOOTING
# ============================================================================
# If the Travel Planner Agent UI page shows errors:
# 1. Ensure backend is running: python -m uvicorn main:app --reload
# 2. Ensure OPENAI_API_KEY is set
# 3. Check AGENT_AUDIT_API_URL points to your running backend
# 4. Frontend should use VITE_API_BASE_URL during build
# 5. For Chrome extension: manually update popup.js and background.js with correct backend URL
# ============================================================================
